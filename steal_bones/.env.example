# Скопируйте этот файл в .env и заполните только то, что реально нужно.
# Все переменные необязательны — без ключа соответствующий адаптер либо
# работает в бесплатном режиме (Magic Eden, все RPC-балансы, mempool.space,
# TronGrid), либо честно откажется с понятным сообщением (см. вкладку
# «Ключи API» в самом приложении — там же пошаговая инструкция получения
# каждого ключа).

# Единый ключ Etherscan V2 — покрывает Ethereum/BNB/Base/Arbitrum/Polygon/
# Avalanche (доп. данные сверх баланса; сам баланс идёт через бесплатный
# RPC и ключа не требует). Можно перечислить несколько через запятую —
# включится ротация при исчерпании лимита (раздел 7.1 ТЗ).
ETHERSCAN_API_KEYS=

OPENSEA_API_KEY=
TENSOR_API_KEY=
RARIBLE_API_KEY=
LOOKSRARE_API_KEY=

# Ускоряет и расширяет проверку Solana (замена Solscan, см. приложение
# «Ключи API» про то, почему Solscan больше не бесплатный).
HELIUS_API_KEY=

TRONGRID_API_KEY=
XVERSE_API_KEY=
BLOCKBERRY_API_KEY=
BIRDEYE_API_KEY=

# Через сколько часов можно перепроверять баланс уже виденного адреса
# (раздел 3.5 ТЗ — кэш баланса)
BALANCE_RECHECK_HOURS=24
